# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）

# ===== Supabase 云端数据源（免登录 / 跨端共享）=====
# 必填：Supabase 项目地址（后台 → Project Settings → API → Project URL）
# 格式：https://<项目引用>.supabase.co（20 位字母数字），不要带尾斜杠
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# 必填：可公开密钥（后台 → Project Settings → API）
# 两种形态均可（取决于项目版本）：
#   新版：sb_publishable_xxxxxxxxxxxxxxxxxxxx
#   旧版：eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.…（anon public，200+ 字符）
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
# ⚠️ 严禁填写 service_role / secret key：它会绕过 RLS，写进前端等于全库可读可写。
#    service_role 仅供本机一次性导入脚本使用，且不得提交。
# 说明：未配置以上两项时，工作台首页会显示明确的配置引导（不会白屏、不会静默降级）。

# 仅「一次性导入本机历史数据」时使用（服务端密钥，拥有全部权限，切勿提交或用于前端）：
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
#   TARGET_EMAIL=teacher@school.com

# ===== AI 模型配置（资料分析模块）=====
# 必填：模型 API Key（默认使用智谱 GLM，注册 https://open.bigmodel.cn 后免费获取）
AI_API_KEY=your_zhipu_api_key_here

# 选填：API 基址（默认智谱 BigModel OpenAI 兼容接口，完全免费）
#   智谱 GLM（默认）：  https://open.bigmodel.cn/api/paas/v4
#   DeepSeek：         https://api.deepseek.com/v1
#   Gemini 2.5 Flash： https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   SiliconFlow：      https://api.siliconflow.cn/v1
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 选填：模型名（默认 glm-4.7-flash，完全免费；glm-4-flash 亦免费且更稳定；如需换 DeepSeek 改为 deepseek-chat）
AI_MODEL=glm-4.7-flash

# 选填：采样温度（默认 0.3；0=更稳定确定，1=更多样发散）
AI_TEMPERATURE=0.3

# 选填：单次请求超时（毫秒，默认 60000）
AI_TIMEOUT_MS=60000

# 选填：失败重试次数（默认 2；仅对超时/限流/5xx/网络错误重试，4xx 鉴权错误不重试）
AI_MAX_RETRIES=2

# ===== 资料上传 / 检索配置 =====
# 选填：单文件传输上限（单位 MB）。业务层不设大小上限，此值仅约束传输体；
# 需与反向代理/网关的 body 限制协调（如 Nginx client_max_body_size），并注意 base64 膨胀约 4/3。
MAX_FILE_MB=500

# 选填：线上链接拉取超时（毫秒，默认 20000）。链接上传时后端抓取资源的超时上限。
URL_FETCH_TIMEOUT_MS=20000

# 选填：AI 转发服务端口（默认 3001）
PORT=3001
